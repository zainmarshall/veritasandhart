---
import Layout from '../../layouts/Layout.astro';
import CaseStudyMark from '../../components/CaseStudyMark.astro';
import { getCollection, getEntry, render } from 'astro:content';

const contactEntry = await getEntry('site', 'contact');
const contactEmail = (contactEntry.data as { email: string }).email;

export async function getStaticPaths() {
  const studies = await getCollection('case-studies', ({ data }) => data.published);
  const sorted = studies.sort((a, b) => a.data.number - b.data.number);
  return sorted.map((entry, i) => ({
    params: { slug: entry.id },
    props: { entry, next: sorted[(i + 1) % sorted.length] },
  }));
}

const { entry, next } = Astro.props;
const { Content } = await render(entry);
const { title, tags, seoTitle, seoDescription, honestCaveat } = entry.data;
---

<Layout title={`${seoTitle} | Veritas & Hart`} description={seoDescription}>
  <article class="section study">
    <a class="back" href="/case-studies">All case studies</a>

    <CaseStudyMark slug={entry.id} size={72} />
    <div class="divider"></div>
    <h1>{title}</h1>

    <div class="tags">
      {tags.map(tag => <span class="tag">{tag}</span>)}
    </div>

    <div class="study-body">
      <Content />
    </div>

    <div class="caveat reveal">
      <span class="caveat-label">The honest caveat</span>
      <p>{honestCaveat}</p>
    </div>

    <div class="study-footer">
      <p>If this problem looks like yours, the best next step is a conversation.</p>
      <div class="footer-links">
        <a class="cta" href={`mailto:${contactEmail}`}>Begin the Conversation</a>
        <a class="next-link" href={`/case-studies/${next.id}`}>Next: {next.data.title}</a>
      </div>
    </div>
  </article>
</Layout>

<style>
  .study { max-width: 760px; }
  .back {
    display: inline-block;
    font-size: 0.78rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--text-light);
    margin-bottom: 2.5rem;
  }
  h1 { font-size: 2.6rem; margin-bottom: 1.25rem; }
  .tags { display: flex; flex-wrap: wrap; gap: 0.6rem; margin-bottom: 2.5rem; }
  .tag {
    font-size: 0.72rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--text-light);
    padding: 0.3rem 0.75rem;
    border: 1px solid var(--border);
    border-radius: 999px;
  }
  .study-body :global(h3) { margin-top: 2.5rem; }
  .study-body :global(p:first-child) {
    font-family: 'Cormorant Garamond', serif;
    font-size: 1.35rem;
    line-height: 1.5;
    color: var(--primary);
  }
  .caveat {
    border-top: 2px solid var(--secondary);
    border-bottom: 1px solid var(--border);
    padding: 1.75rem 0 0.75rem;
    margin: 2.75rem 0 2rem;
  }
  .caveat-label {
    display: block;
    font-size: 0.75rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--secondary);
    margin-bottom: 1rem;
    font-weight: 500;
  }
  .study-footer {
    margin-top: 3rem;
    padding-top: 2rem;
    border-top: 1px solid var(--border);
  }
  .footer-links {
    display: flex;
    flex-wrap: wrap;
    gap: 1.5rem;
    align-items: center;
    margin-top: 0.5rem;
  }
  .cta {
    display: inline-block;
    background-color: var(--primary);
    color: var(--background);
    padding: 0.8rem 1.6rem;
    font-size: 0.85rem;
    letter-spacing: 0.04em;
    border-radius: 2px;
  }
  .cta:hover { background-color: var(--secondary); text-decoration: none; }
  .next-link { font-size: 0.85rem; color: var(--text-light); }
  @media (max-width: 768px) { h1 { font-size: 1.9rem; } }
</style>
