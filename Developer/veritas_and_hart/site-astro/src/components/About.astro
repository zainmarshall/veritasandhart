---
interface Props {
  about: { heading: string; paragraphs: string[]; credentials: string[] };
}
const { about } = Astro.props;
---
<section class="section">
  <div class="reveal">
    <div class="divider"></div>
    <h2>{about.heading}</h2>
  </div>
  <div class="about-body">
    {about.paragraphs.map((p, i) => (
      <p class="reveal" style={`transition-delay: ${i * 100}ms`}>{p}</p>
    ))}
  </div>
  <div class="credentials">
    {about.credentials.map((c, i) => (
      <span class="credential reveal" style={`transition-delay: ${i * 100 + 300}ms`}>{c}</span>
    ))}
  </div>
</section>
<style>
  .about-body { max-width: 680px; }
  .about-body p { font-size: 1.05rem; line-height: 1.85; }
  .credentials { margin-top: 3rem; display: flex; gap: 2rem; flex-wrap: wrap; }
  .credential {
    font-size: 0.8rem;
    font-weight: 500;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--secondary);
    padding: 0.4rem 0;
    border-bottom: 1px solid var(--secondary);
  }
</style>
