---
interface Props { slug: string; size?: number; }
const { slug, size = 72 } = Astro.props;

// Precompute spoke coordinates for marriott-cloud-point-of-sale
const spokeAngles = [0, 60, 120, 180, 240, 300];
const spokes = spokeAngles.map(angle => ({
  x1: 48 + 10 * Math.cos((angle * Math.PI) / 180),
  y1: 48 + 10 * Math.sin((angle * Math.PI) / 180),
  x2: 48 + 30 * Math.cos((angle * Math.PI) / 180),
  y2: 48 + 30 * Math.sin((angle * Math.PI) / 180),
}));

// Precompute converging lines for single-source-of-truth
const convergingYs = [14, 31, 48, 65, 82];
const convergingPaths = convergingYs.map(y => `M8 ${y} C30 ${y} 38 ${48 + (y - 48) * 0.15} 48 48`);

const knownSlugs = [
  'on-time-delivery-amazon-robotics',
  'marriott-cloud-point-of-sale',
  'gaylord-national-turnaround',
  'resource-discipline-amazon-robotics',
  'portfolio-adoption-48-to-90',
  'fortune-100-talent-strategy',
  'single-source-of-truth',
  'marriott-analytics-maturity',
  'service-level-stalemate',
  'rebuilding-analytical-capability',
  'developing-leaders-at-a-distance',
];
---

<svg
  width={size}
  height={size}
  viewBox="0 0 96 96"
  fill="none"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  class="mark"
>
  {slug === 'on-time-delivery-amazon-robotics' && (
    <Fragment>
      <path d="M8 36 L24 50 L36 44 L48 66 L64 40 L86 24" class="p" />
      <circle cx="86" cy="24" r="3.5" class="g fill" />
    </Fragment>
  )}
  {slug === 'marriott-cloud-point-of-sale' && (
    <Fragment>
      {spokes.map(s => (
        <Fragment>
          <line x1={s.x1} y1={s.y1} x2={s.x2} y2={s.y2} class="p" />
          <circle cx={s.x2} cy={s.y2} r="3" class="p fillp" />
        </Fragment>
      ))}
      <circle cx="48" cy="48" r="7" class="g" />
    </Fragment>
  )}
  {slug === 'gaylord-national-turnaround' && (
    <Fragment>
      <path d="M12 78 H28 V63 H44 V48 H60 V33 H76 V20 H84" class="p" />
      <circle cx="84" cy="20" r="3.5" class="g fill" />
    </Fragment>
  )}
  {slug === 'resource-discipline-amazon-robotics' && (
    <Fragment>
      <path d="M16 62 A32 32 0 0 1 80 62" class="p" />
      <line x1="48" y1="62" x2="67" y2="36" class="g" />
      <circle cx="48" cy="62" r="3.5" class="p fillp" />
    </Fragment>
  )}
  {slug === 'portfolio-adoption-48-to-90' && (
    <Fragment>
      <path d="M10 78 C34 78 36 68 48 52 C60 36 62 20 86 16" class="p" />
      <circle cx="86" cy="16" r="3.5" class="g fill" />
    </Fragment>
  )}
  {slug === 'fortune-100-talent-strategy' && (
    <Fragment>
      <rect x="20" y="20" width="56" height="56" class="p" />
      <line x1="48" y1="20" x2="48" y2="76" class="p" />
      <line x1="20" y1="48" x2="76" y2="48" class="p" />
      <circle cx="62" cy="34" r="4" class="g fill" />
    </Fragment>
  )}
  {slug === 'single-source-of-truth' && (
    <Fragment>
      {convergingPaths.map(d => <path d={d} class="p" />)}
      <circle cx="52" cy="48" r="4" class="g" />
      <line x1="58" y1="48" x2="88" y2="48" class="p wide" />
    </Fragment>
  )}
  {slug === 'marriott-analytics-maturity' && (
    <Fragment>
      <line x1="36" y1="12" x2="36" y2="84" class="p" />
      <line x1="60" y1="12" x2="60" y2="84" class="p" />
      <line x1="36" y1="72" x2="60" y2="72" class="p" />
      <line x1="36" y1="52" x2="60" y2="52" class="p" />
      <line x1="36" y1="34" x2="60" y2="34" class="p" />
      <line x1="36" y1="18" x2="60" y2="18" class="g" />
    </Fragment>
  )}
  {slug === 'service-level-stalemate' && (
    <Fragment>
      <path d="M8 32 C28 32 38 45 50 48" class="g" />
      <path d="M8 64 C28 64 38 51 50 48" class="p" />
      <line x1="50" y1="48" x2="88" y2="48" class="p" />
      <circle cx="88" cy="48" r="3.5" class="g fill" />
    </Fragment>
  )}
  {slug === 'rebuilding-analytical-capability' && (
    <Fragment>
      <line x1="16" y1="54" x2="80" y2="54" class="g" />
      <path d="M16 74 L38 66 L56 50 L78 30" class="p" />
      <circle cx="78" cy="30" r="3.5" class="p fillp" />
    </Fragment>
  )}
  {slug === 'developing-leaders-at-a-distance' && (
    <Fragment>
      <line x1="14" y1="82" x2="82" y2="82" class="p soft" />
      <line x1="28" y1="82" x2="28" y2="44" class="p" />
      <line x1="48" y1="82" x2="48" y2="26" class="g" />
      <line x1="68" y1="82" x2="68" y2="36" class="p" />
      <circle cx="28" cy="44" r="3.5" class="p fillp" />
      <circle cx="48" cy="26" r="3.5" class="g fill" />
      <circle cx="68" cy="36" r="3.5" class="p fillp" />
    </Fragment>
  )}
  {!knownSlugs.includes(slug) && (
    <circle cx="48" cy="48" r="28" class="p" />
  )}
</svg>

<style>
  .mark { display: block; }
  .p { stroke: var(--primary); stroke-width: 2; }
  .g { stroke: var(--secondary); stroke-width: 2; }
  .fill { fill: var(--secondary); }
  .fillp { fill: var(--primary); }
  .wide { stroke-width: 3.5; }
  .soft { opacity: 0.35; }
  rect, circle:not(.fill):not(.fillp), path, line { fill: none; }
</style>
