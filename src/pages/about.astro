---
import Layout from '../layouts/Layout.astro';
import About from '../components/About.astro';
import { getEntry } from 'astro:content';

const entry = await getEntry('site', 'about');
const about = entry.data as { heading: string; paragraphs: string[]; credentials: string[] };
---
<Layout
  title="About — Veritas & Hart | Ummara Marshall, Founder & Principal"
  description="Founded by Ummara (Mara) Marshall. 25+ years of transformation leadership across Amazon, Marriott, investment banking. Harvard Economics, PMP, Lean Six Sigma Black Belt."
>
  <About {about} />
</Layout>
